{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Snapify - Spotify Overlay",
  "version": "2.0.4",
  "identifier": "com.snapify.spotify-overlay",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Snapify - Spotify Overlay",
        "width": 1280,
        "height": 800,
        "minWidth": 400,
        "minHeight": 300,
        "fullscreen": false,
        "maximized": true,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "resizable": true,
        "maximizable": true,
        "visible": true,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/tonscamacho/snapify-spotify-overlay/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM2NjBCRENGRjZCQUQxMDAKUldRQTBicjJ6NzFneGpxYUxUNjZwTm9OVExXQ2VkdlpZWjAydnpSN0Voa0pmR0lQU0xnK2tFQk0K"
    }
  }
}
